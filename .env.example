# Configuration
# Local defaults. Override for hosted deployments; see README.md.
HOST=127.0.0.1
PORT=8099

# Generated outputs (PDF reports, figures, characterisation CSV) are written
# here and served under /generated. On Render this should be the mount path of
# the persistent disk, e.g. /app/app/_generated. Leave unset to use the local
# default app/_generated relative to the app package.
# GENERATED_DIR=

# Optional openLCA IPC integration. Leave unset for offline / stateless use.
# The dashboard degrades gracefully when openLCA is unavailable.
OPENLCA_HOST=127.0.0.1
OPENLCA_PORT=8080

